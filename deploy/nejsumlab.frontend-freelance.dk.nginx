server {
    listen 80;
    listen [::]:80;
    server_name nejsumlab.frontend-freelance.dk;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name nejsumlab.frontend-freelance.dk;

    ssl_certificate /etc/letsencrypt/live/nejsumlab.frontend-freelance.dk/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/nejsumlab.frontend-freelance.dk/privkey.pem;

    root /opt/asset-calendar/current/dist;
    index index.html;

    location ^~ /_/ {
        return 404;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8090;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
